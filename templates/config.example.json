{
  "_README": "把本文件复制成项目里的 <项目>/.rtd/config.json 并填入真实值。该文件权限 0600，不进任何仓库；配置值不回显、不写进证据与报告。开源组件的构件与本地配方不在这里——见仓库 governance/oss-components.json；实验台的 runner / 安装根目录等本机设置放同目录的 .rtd/lab.json（模板见 templates/lab.example.json）。",
  "executors": {
    "cli": {
      "cmd": "<平台 CLI 可执行名>",
      "install_hint": "<安装方式>",
      "workspace_flag": "<工作区参数>"
    },
    "mcp_dev": "<研发域 MCP 服务名>",
    "mcp_ops": "<运维域 MCP 服务名>",
    "mcp_asset": "<资产/项目 MCP 服务名>",
    "mcp_engine": "<引擎只读 MCP 服务名>",
    "storage": {
      "log_cli": "<日志平台 CLI>",
      "light_db_cli": "<轻量库 CLI>"
    },
    "oss_flink": {
      "home": "<Flink 安装目录，例如 ~/oss/flink-2.2.0>",
      "sql_client": "<home>/bin/sql-client.sh",
      "rest_endpoint": "http://127.0.0.1:8081",
      "java_home": "<JDK 路径>"
    },
    "oss_paimon": {
      "connector_jar": "<paimon-flink-<版本>.jar 路径>",
      "catalog_type": "paimon",
      "warehouse": "file:///tmp/paimon-warehouse"
    },
    "oss_fluss": {
      "home": "<Fluss 安装目录>",
      "bootstrap_servers": "<host:port>",
      "connector_jar": "<fluss-flink-<版本>.jar 路径>"
    },
    "oss_kafka": {
      "home": "<Kafka 安装目录，例如 ~/oss/kafka>",
      "bootstrap_servers": "<host:port，例如 127.0.0.1:9092>"
    },
    "oss_spark": {
      "home": "<Spark 安装目录，例如 ~/oss/spark-4.1.3-bin-hadoop3>",
      "master": "local[1]",
      "kafka_package": "<spark-sql-kafka 连接器坐标>",
      "lake_jars": ["<湖表 runtime jar 路径，可多个>"]
    },
    "oss_iceberg": {
      "runtime_jar": "<iceberg runtime jar 路径>",
      "warehouse": "file:///tmp/iceberg-warehouse"
    },
    "oss_hudi": {
      "runtime_jar": "<hudi bundle jar 路径>",
      "warehouse": "file:///tmp/hudi-warehouse"
    },
    "oss_delta": {
      "runtime_jar": "<delta runtime jar 路径>",
      "warehouse": "file:///tmp/delta-warehouse"
    }
  },
  "knowledge": {
    "uri_prefix": "viking://resources/",
    "index_path": "<可选：覆盖知识索引路径；留空则按 .rtd/mock/kb/index.json → .data-dev/mock/kb/index.json 的顺序探测>"
  },
  "limits": {
    "scan_budget_s": 120,
    "tool_calls": 60,
    "inflight": 3,
    "external_nodes": 30,
    "poll_interval_s": 10,
    "poll_timeout_s": 300,
    "read_chunk_lines": 2000,
    "confirm_window_minutes": 30,
    "record_read_lines": 50
  }
}
