{
  "description": "realtime-data-plugin 两道防线：PreToolUse 硬门（证据保护 / --yes 自行追加 / 高风险动词）+ SessionStart 阶段提醒。Claude Code 与 Codex 共用本文件；Windows 用 py -3，macOS/Linux 跑 tools/adapt_hooks.py 切换为 python3。",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sessionstart.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
